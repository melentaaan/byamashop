# =====================================================================
# Byamashop — variables d'environnement
# Copiez ce fichier en « .env » pour le développement local, et saisissez
# les mêmes variables dans Netlify › Site configuration › Environment variables.
# =====================================================================

# --- Supabase (Project Settings › API) -------------------------------
# URL du projet et clé « anon public ». Cette clé est publique par conception :
# la sécurité repose sur les règles RLS de la base (supabase/migrations).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Adresse publique du site (liens canoniques, sitemap, partages)
VITE_SITE_URL=https://byamashop.netlify.app

# Mode démonstration forcé (données stockées dans le navigateur uniquement).
# Laissez vide en production. Si Supabase n'est pas configuré, le site passe
# automatiquement en mode démonstration avec un bandeau visible.
VITE_DEMO_MODE=

# --- Paiement Wave automatique (OPTIONNEL, désactivé par défaut) --------
# Uniquement côté serveur (fonctions Netlify) : ne JAMAIS préfixer par VITE_.
# Sans ces deux valeurs, le webhook répond 503 et les paiements restent
# confirmés manuellement par l'administratrice.
WAVE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
